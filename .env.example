# Gemini AI API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model selection - uncomment the model you want to use
# GEMINI_MODEL=gemini-2.0-pro-exp-02-05
GEMINI_MODEL=gemini-2.5-pro-preview-03-25

# Dash robot MAC address - replace with your Dash robot's MAC address
MAC_ADDRESS=XX:XX:XX:XX:XX:XX

# Input mode: 'typing' or 'voice'
INPUT_MODE=typing

# Set to True to connect Dash, False to run in text-only mode for quick testing
CONNECT_DASH=False